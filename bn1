std::uint64_t decrypt_bn1(std::uint64_t a1) 
{
    std::uintptr_t rax = g_HyperInterface->read<std::uint64_t>(a1 + 0x18);
    std::uint32_t* rdx = (std::uint32_t*)&rax;
    std::uint32_t  r8d = 2;

    do {
        std::uint32_t v = *rdx;
        rdx = (std::uint32_t*)((char*)rdx + 4);
        v += 0x3F41EF1E;
        v  = (v << 15) | (v >> 17);
        v += 0xC46447C5;
        v  = (v << 15) | (v >> 17);
        *((std::uint32_t*)rdx - 1) = v;
    } while (--r8d);

    return rax;
}
