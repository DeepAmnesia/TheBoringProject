std::uint64_t decrypt_bn1(std::uint64_t a1)
{
    std::uint64_t value = g_HyperInterface->read<std::uint64_t>(a1 + 0x18);
    if (!value)
        return 0;

    std::uint32_t* chunks = reinterpret_cast<std::uint32_t*>(&value);

    for (int i = 0; i < 2; i++) {
        std::uint32_t v = chunks[i];
        v ^= 0xDD40083B;
        v -= 0x56499A58;
        v ^= 0x74FA9C91;
        chunks[i] = v;
    }

    return value;
}
