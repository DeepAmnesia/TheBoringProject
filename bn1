std::uint64_t decrypt_bn1(std::uint64_t a1)
{
    uint64_t value = g_HyperInterface->read<uint64_t>(a1 + 0x18);
    uint32_t* data = (uint32_t*)&value;
    uint32_t count = 2;

    do
    {
        uint32_t x = *data;
        uint32_t y = x + 23732553;
        uint32_t result = ((y << 7) | (y >> 25)) + 70083743;
        *data = result;
        data++;
        --count;
    } while (count);

    return value;
}
