std::uint64_t decrypt_bn1(std::uint64_t a1)
{
    uint32_t eax = 0, ecx = 0, r14d = 0;
    uintptr_t rax = 0, rbx = 0, rcx = a1, rdi = a1;
    
    rax = g_HyperInterface->read<uintptr_t>(rdi + 0x18);
    uint32_t* rdx = (uint32_t*)&rax;
    
    for (uint32_t r8d = 2; r8d > 0; --r8d) {
        // UNHANDLED INSTRUCTION: nop
        eax = *(uint32_t*)(rdx); // mov eax, [rdx]
        rdx = (uint32_t*)((uint8_t*)rdx + 0x04); // lea rdx, [rdx+0x04]
        eax -= 0x5ADF7A4E; // sub eax, 0x5ADF7A4E
        eax ^= 0xFFFFFFFFD5554086; // xor eax, 0xD5554086
        ecx = eax; // mov ecx, eax
        ecx >>= 0x1D; // shr ecx, 0x1D
        eax = eax * 8; // lea eax, [rax*8]
        ecx |= eax; // or ecx, eax
        ecx -= 0x33B0F636; // sub ecx, 0x33B0F636
        *((uint32_t*)rdx - 1) = ecx; // mov [rdx-0x04], ecx
    }
    
    return rax;
}
