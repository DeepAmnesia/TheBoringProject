    do {
        std::uint32_t v = *rdx;
        rdx = (std::uint32_t*)((char*)rdx + 4);
        v ^= 0xDD40083B;
        v -= 0x56499A58;
        v ^= 0x74FA9C91;
        *((std::uint32_t*)rdx - 1) = v;
    } while (--r8d);

