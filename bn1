std::uint64_t decrypt_bn1(std::uint64_t a1)
{
    uint64_t value = g_HyperInterface->read<uint64_t>(a1 + 0x18);
    uint32_t* chunks = reinterpret_cast<uint32_t*>(&value);

    for (int i = 0; i < 2; i++)
    {
        uint32_t v = chunks[i];
        v = (v << 27) | (v >> 5);
        v ^= 0xD12F9B81u;
        v = (v << 5) | (v >> 27);
        chunks[i] = v;
    }

    return value;
}
