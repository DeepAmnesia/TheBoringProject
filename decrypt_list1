std::uint64_t decrypt_list1(std::uint64_t a1)
{
    uint64_t value = g_HyperInterface->read<uint64_t>(a1 + 0x18);
    uint32_t* chunks = reinterpret_cast<uint32_t*>(&value);

    for (int i = 0; i < 2; i++) 
    {
        uint32_t v = chunks[i];
        v += 0x0374D4FAu;
        v = (v << 27) | (v >> 5);
        v ^= 0x5DD1D7B5u;
        v -= 0x10D77418u;
        chunks[i] = v;
    }

    return value;
}
